{
  // Một Worker phục vụ cả trang game (thư mục public) lẫn phòng chơi nhiều người (/api/*).
  "name": "thpt-ninh-giang",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-16",
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "SchoolRoom" }]
  },
  // Gói Free chỉ hỗ trợ Durable Object dùng SQLite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SchoolRoom"] }]
}
